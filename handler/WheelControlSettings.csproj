<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>WheelControlSettings</RootNamespace>
    <AssemblyName>WheelControlSettings</AssemblyName>
    <!-- Same bitness as the console app for consistency. -->
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <!-- Both projects share the repository root; sources are listed explicitly
         so the default globbing does not cross between them. -->
    <EnableDefaultItems>false</EnableDefaultItems>
    <!-- Exe icon; applied only when assets/icon.ico exists. -->
    <ApplicationIcon Condition="Exists('assets\icon.ico')">assets\icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="src\WheelControlSettings\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Step 8 of the spec: runtime assets go to Assets\. MainForm/AboutForm
         read icon.ico from the Assets folder next to the exe. A missing file
         is fine — the forms keep the default icon. About dialog icons:
         rasterized at runtime with Svg.NET; a missing or broken SVG falls back
         to the round red stub (see AboutForm). -->
    <None Include="assets\icon.ico" Link="Assets\icon.ico" CopyToOutputDirectory="PreserveNewest" />
    <None Include="assets\github.svg" Link="Assets\github.svg" CopyToOutputDirectory="PreserveNewest" />
    <None Include="assets\beamng.svg" Link="Assets\beamng.svg" CopyToOutputDirectory="PreserveNewest" />
    <None Include="assets\bio.svg" Link="Assets\bio.svg" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- Lightweight SVG rasterizer for the About icons — no SkiaSharp/
         ImageSharp, no native dependencies. -->
    <PackageReference Include="Svg" Version="3.4.7" />
  </ItemGroup>

  <!-- Step 5, item 6: git stamp written into
       AssemblyInformationalVersionAttribute as "commit: <short hash>"
       (or "commit: dev" when git/the repo is unavailable); AboutForm shows
       it as the commit line. Without .git the target is skipped and the
       runtime fallback produces "commit: dev" as well. -->
  <Target Name="GitCommitStamp" BeforeTargets="GenerateAssemblyInfo" Condition="Exists('.git')">
    <Exec Command="git rev-parse --short HEAD 2&gt;nul"
          ConsoleToMSBuild="true"
          IgnoreExitCode="true"
          StandardOutputImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="GitCommitHash" />
      <Output TaskParameter="ExitCode" PropertyName="GitCommitExit" />
    </Exec>
    <PropertyGroup>
      <_CommitStamp Condition="'$(GitCommitExit)' == '0' And '$(GitCommitHash)' != ''">commit: $(GitCommitHash)</_CommitStamp>
      <_CommitStamp Condition="'$(_CommitStamp)' == ''">commit: dev</_CommitStamp>
      <InformationalVersion>$(_CommitStamp)</InformationalVersion>
    </PropertyGroup>
  </Target>

</Project>
