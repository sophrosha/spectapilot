<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>MozaWheelControl</RootNamespace>
    <AssemblyName>MozaWheelControl</AssemblyName>
    <!-- Руль x64: MOZA_API_C.dll и MOZA_SDK.dll только 64-битные -->
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <RollForward>Major</RollForward>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- В папке sdk лежит свой пример (ShifterTest.cs) с top-level statements —
         не даём MSBuild включить его в наш проект. -->
    <Compile Remove="sdk\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- C# обёртка Moza SDK (целится в .NET Framework 4.8 — с .NET 8 совместима,
         т.к. ссылается только на mscorlib). -->
    <Reference Include="MOZA_API_CSharp">
      <HintPath>sdk\SDK_CSharp\x64\MOZA_API_CSharp.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!-- Нативные зависимости кладём рядом с exe (иначе DllNotFoundException) -->
    <None Include="sdk\SDK_CSharp\x64\MOZA_API_C.dll" Link="MOZA_API_C.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="sdk\SDK_CSharp\x64\MOZA_SDK.dll" Link="MOZA_SDK.dll" CopyToOutputDirectory="PreserveNewest" />
    <!-- Дефолтный конфиг рядом с exe -->
    <None Include="config.json" Link="config.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
